# Copy to .env and fill in. Never commit the real .env.

# Required: Claude API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Optional: live YouTube trending data (Google Cloud console > YouTube Data API v3 > API key)
YOUTUBE_API_KEY=
YOUTUBE_REGION=US

# Voice: ElevenLabs API key. Skip with --silent-voice for a text-only dry run.
ELEVENLABS_API_KEY=

# Google Drive upload (only with --upload)
# Path to an OAuth client secrets JSON or a service-account key JSON
GOOGLE_APPLICATION_CREDENTIALS=
# The ID at the end of the Drive folder URL
GOOGLE_DRIVE_FOLDER_ID=

# Tuning
CLAUDEYOUBOT_MODEL=claude-opus-5-5
CLAUDEYOUBOT_REFINE_ROUNDS=5
CLAUDEYOUBOT_VOICE_CANDIDATES=5
CLAUDEYOUBOT_OUTPUT_DIR=output
